# Leave VITE_API_URL empty in production (Vercel) — API lives at /api/*.
# Set it to http://localhost:3000 (or wherever `vercel dev` runs) for local dev.
VITE_API_URL=
VITE_CHAIN_ID=11155111
# Public RPC used for read-only browsing when no wallet is connected.
# Use a free public Sepolia endpoint or your own Infura/Alchemy URL.
VITE_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_REGISTRY_ADDRESS=0x...
VITE_CREDIT_ADDRESS=0x...
VITE_MARKET_ADDRESS=0x...
